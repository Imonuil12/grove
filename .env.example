# Copy to .env (repo root) and fill in. This is the only .env the backend reads
# (see app/backend/env_config.py). Real environment variables override it.

# LLM providers: an OpenAI-compatible API is tried first, Gemini is the
# fallback. With neither, the chatbot uses its built-in rule-based answers.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# Point the OpenAI client at a free/local provider instead of OpenAI:
#   Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.1  (no key needed)
#   Groq:    OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_BASE_URL=

# Leave the Cognito values empty to use built-in email/password accounts.
# Your own AWS Cognito user pool (public values; served to the browser via /auth/config)
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Optional, only for hosted-UI / social sign-in
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=
SESSION_ENCRYPTION_KEY=

# Signs built-in account sessions. Use a long random value (32+ chars).
JWT_SECRET=
